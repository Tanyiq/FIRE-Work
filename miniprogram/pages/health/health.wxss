.health-hero {
  margin-top: 42rpx;
  padding: 42rpx 36rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #243a30, #46705b);
  box-shadow: 0 18rpx 46rpx rgba(42, 57, 48, 0.18);
}

.health-hero__label,
.health-hero__type,
.health-hero__asset,
.empty-title,
.empty-text {
  display: block;
}

.health-hero__label {
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
}

.health-hero__type {
  margin-top: 18rpx;
  font-size: 46rpx;
  font-weight: 700;
}

.health-hero__asset {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 25rpx;
}

.health-card,
.empty-card,
.conclusion-card {
  margin-top: 24rpx;
  padding: 34rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.empty-card {
  margin-top: 32rpx;
  padding: 52rpx 36rpx;
  text-align: center;
}

.empty-title {
  font-size: 31rpx;
  font-weight: 650;
}

.empty-text {
  margin-top: 14rpx;
  color: #747d78;
  font-size: 25rpx;
  line-height: 1.65;
}

.card-heading,
.safety-detail,
.structure-summary,
.structure-row,
.trend-grid {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-index {
  display: block;
  color: #d5a94e;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.section-title {
  display: block;
  margin-top: 7rpx;
  font-size: 32rpx;
  font-weight: 650;
}

.key-result {
  color: #2f6b4f;
  font-size: 39rpx;
  font-weight: 700;
}

.safety-detail,
.trend-grid {
  margin-top: 28rpx;
  padding: 26rpx;
  border-radius: 18rpx;
  background: #f5f6f3;
}

.detail-right,
.trend-item--right,
.summary-item--right {
  text-align: right;
}

.detail-label,
.detail-value,
.summary-label,
.summary-value,
.summary-hint,
.missing-state__title,
.missing-state__text {
  display: block;
}

.detail-label,
.summary-label {
  color: #758078;
  font-size: 23rpx;
}

.detail-value {
  margin-top: 8rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.missing-state {
  margin-top: 26rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: #f3f3ef;
}

.missing-state__title {
  font-size: 27rpx;
  font-weight: 600;
}

.missing-state__text {
  margin-top: 9rpx;
  color: #77817b;
  font-size: 24rpx;
  line-height: 1.6;
}

.secondary-button {
  margin-top: 24rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.secondary-button {
  color: #2f6b4f;
  background: #e6eee8;
}

.secondary-button::after {
  border: 0;
}

.text-action {
  display: block;
  margin-top: 22rpx;
  color: #2f6b4f;
  font-size: 24rpx;
  text-align: right;
}

.structure-summary {
  margin-top: 28rpx;
}

.summary-item,
.trend-item {
  flex: 1;
}

.summary-divider {
  width: 1rpx;
  height: 94rpx;
  margin: 0 28rpx;
  background: #e6e9e4;
}

.summary-value {
  margin-top: 7rpx;
  color: #2f6b4f;
  font-size: 38rpx;
  font-weight: 700;
}

.summary-hint {
  margin-top: 5rpx;
  color: #8a918d;
  font-size: 20rpx;
}

.other-ratio {
  margin-top: 18rpx;
  color: #727c76;
  font-size: 23rpx;
  text-align: center;
}

.structure-list {
  margin-top: 30rpx;
}

.structure-item {
  margin-top: 20rpx;
}

.structure-row {
  color: #59645e;
  font-size: 24rpx;
}

.structure-track {
  height: 12rpx;
  margin-top: 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e9ece8;
}

.structure-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #5b8b70;
}

.healthy-note,
.risk-note {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 17rpx;
  font-size: 24rpx;
  line-height: 1.55;
}

.healthy-note {
  color: #2f6b4f;
  background: #eaf2ec;
}

.risk-note {
  display: flex;
  gap: 16rpx;
  color: #795c2d;
  background: #f8efd9;
}

.risk-icon {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #b7893c;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
}

.period-label {
  display: block;
  margin-top: 8rpx;
  color: #7a817d;
  font-size: 23rpx;
}

.trend-value {
  display: block;
  margin-top: 9rpx;
  color: #2f6b4f;
  font-size: 34rpx;
  font-weight: 700;
}

.conclusion-card {
  color: #ffffff;
  background: #2c493a;
}

.conclusion-title,
.conclusion-label,
.conclusion-item,
.disclaimer {
  display: block;
}

.conclusion-title {
  font-size: 34rpx;
  font-weight: 700;
}

.conclusion-section {
  margin-top: 30rpx;
}

.conclusion-label {
  color: rgba(255, 255, 255, 0.62);
  font-size: 23rpx;
}

.conclusion-item {
  margin-top: 13rpx;
  font-size: 26rpx;
  line-height: 1.55;
}

.conclusion-item--good {
  color: #d8eddf;
}

.conclusion-item--warning {
  color: #f1dba9;
}

.disclaimer {
  margin-top: 32rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.52);
  font-size: 21rpx;
}
