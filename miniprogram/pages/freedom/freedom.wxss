.archive-hero {
  margin-top: 40rpx;
  padding: 38rpx 34rpx;
  border-radius: 28rpx;
  border-radius: var(--radius-lg);
  color: #ffffff;
  background: linear-gradient(150deg, var(--color-brand-dark), var(--color-brand-end));
  box-shadow: 0 18rpx 46rpx rgba(42, 72, 56, 0.2);
}

.archive-label,
.distance-value,
.metric-label,
.metric-value,
.onboarding-eyebrow,
.onboarding-title,
.step-title,
.step-text,
.advice-entry__eyebrow,
.advice-entry__title,
.advice-entry__text,
.fire-reference-label,
.fire-reference-title,
.fire-reference-text,
.fire-reference-action,
.setup-kicker,
.section-title,
.setup-note,
.goal-description,
.validation-message {
  display: block;
}

.archive-label {
  color: rgba(255, 255, 255, 0.6);
  font-size: 22rpx;
}

.distance-value {
  margin-top: 10rpx;
  font-size: 51rpx;
  font-weight: 750;
}

.level-summary {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-top: 22rpx;
}

.continuous-level {
  color: #e5bd67;
  font-size: 38rpx;
  font-weight: 700;
}

.stage-name {
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
}

.hero-progress {
  height: 13rpx;
  margin-top: 22rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.17);
}

.hero-progress__fill {
  height: 100%;
  border-radius: 999rpx;
  background: #e5bd67;
  transition: width 32ms linear;
}

.archive-metrics {
  display: flex;
  margin-top: 28rpx;
  padding-top: 25rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.15);
}

.archive-metric {
  flex: 1;
}

.archive-metric--center {
  text-align: center;
}

.archive-metric--right {
  text-align: right;
}

.metric-label {
  color: rgba(255, 255, 255, 0.55);
  font-size: 20rpx;
}

.metric-value {
  margin-top: 7rpx;
  font-size: 24rpx;
  font-weight: 650;
}

.metric-value--positive {
  color: #d8efdf;
}

.metric-value--negative {
  color: #ffd6d0;
}

.goal-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 25rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 21rpx;
}

.onboarding-card,
.first-guide,
.setup-section,
.fire-reference-card {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  border-radius: var(--radius-md);
  background: #ffffff;
  background: var(--color-surface);
}

.archive-complete-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  gap: var(--space-sm);
  margin-top: 24rpx;
  margin-top: var(--space-md);
  padding: 24rpx 32rpx;
  padding: var(--space-md) var(--space-lg);
  border: 1rpx solid #d8e6dc;
  border-radius: 24rpx;
  border-radius: var(--radius-md);
  background: var(--color-brand-surface);
  animation: achievement-in 420ms ease-out both;
  animation: achievement-in var(--motion-growth) ease-out both;
}

.achievement-mark {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  color: #ffffff;
  background: var(--color-brand);
  background: var(--color-brand);
  font-size: 24rpx;
  font-size: var(--font-body);
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
}

.achievement-main {
  min-width: 0;
}

.achievement-title,
.achievement-text {
  display: block;
}

.achievement-title {
  color: var(--color-brand-dark);
  color: var(--color-brand-dark);
  font-size: 28rpx;
  font-size: var(--font-subtitle);
  font-weight: 650;
}

.achievement-text {
  margin-top: 8rpx;
  margin-top: var(--space-xs);
  color: #727c76;
  color: var(--color-text-muted);
  font-size: 20rpx;
  font-size: var(--font-caption);
  line-height: 1.5;
}

@keyframes achievement-in {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.onboarding-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.onboarding-eyebrow,
.setup-kicker {
  color: #b1883e;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.onboarding-title,
.section-title {
  margin-top: 7rpx;
  font-size: 31rpx;
  font-weight: 650;
}

.onboarding-progress {
  color: var(--color-brand);
  font-size: 26rpx;
  font-weight: 700;
}

.guide-step {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eceeea;
}

.guide-step--last {
  border-bottom: 0;
}

.step-number {
  flex-shrink: 0;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  color: #737c76;
  background: #eceeeb;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 42rpx;
  text-align: center;
}

.guide-step--done .step-number,
.guide-step--active .step-number {
  color: #ffffff;
  background: var(--color-brand);
}

.step-main {
  flex: 1;
  min-width: 0;
}

.step-title {
  font-size: 26rpx;
  font-weight: 600;
}

.step-text {
  margin-top: 6rpx;
  color: #848c87;
  font-size: 21rpx;
}

.step-action,
.current-badge {
  flex-shrink: 0;
  color: var(--color-brand);
  font-size: 22rpx;
  font-weight: 600;
}

.current-badge {
  padding: 6rpx 11rpx;
  border-radius: 999rpx;
  background: var(--color-brand-soft);
}

.advice-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 29rpx 31rpx;
  border-radius: 22rpx;
  color: #ffffff;
  background: var(--color-brand-dark);
}

.advice-entry__eyebrow {
  color: #e3bd6c;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.advice-entry__title {
  margin-top: 7rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.advice-entry__text {
  margin-top: 7rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 21rpx;
}

.advice-entry__arrow {
  margin-left: 18rpx;
  color: #e3bd6c;
  font-size: 44rpx;
}

.fire-reference-card {
  border: 1rpx solid #e5dfd2;
  background: #fffdf8;
}

.fire-reference-label {
  color: #987630;
  font-size: 20rpx;
  font-weight: 600;
}

.fire-reference-title {
  margin-top: 9rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.fire-reference-text {
  margin-top: 8rpx;
  color: #7b817d;
  font-size: 21rpx;
  line-height: 1.55;
}

.fire-reference-action {
  margin-top: 14rpx;
  color: var(--color-brand);
  font-size: 22rpx;
  font-weight: 600;
  text-align: right;
}

.action-row {
  display: flex;
  gap: 18rpx;
  margin-top: 26rpx;
}

.action-button {
  flex: 1;
  margin: 0;
  width: 0;
  min-height: 88rpx;
  padding: 0 20rpx;
  line-height: 88rpx;
}

.primary-button.action-button {
  margin-top: 0;
}

.primary-button,
.secondary-button {
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.primary-button {
  margin-top: 28rpx;
  color: #ffffff;
  background: var(--color-brand);
}

.secondary-button {
  color: var(--color-brand);
  background: var(--color-brand-soft);
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

.first-guide {
  margin-top: 38rpx;
}

.setup-section {
  margin-top: 24rpx;
}

.setup-note {
  margin-top: 8rpx;
  color: #7d8580;
  font-size: 22rpx;
}

.goal-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

.goal-card {
  padding: 26rpx;
  border: 2rpx solid #eceeea;
  border-radius: 19rpx;
}

.goal-card--selected {
  border-color: var(--color-brand);
  background: var(--color-brand-surface);
}

.goal-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.goal-level {
  font-size: 28rpx;
  font-weight: 600;
}

.goal-asset {
  flex-shrink: 0;
  color: var(--color-brand);
  font-size: 25rpx;
  font-weight: 600;
}

.goal-description {
  margin-top: 9rpx;
  color: #747d78;
  font-size: 23rpx;
  line-height: 1.5;
}

.validation-message {
  margin-top: 17rpx;
  color: #b5473c;
  font-size: 24rpx;
}
