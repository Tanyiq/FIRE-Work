.setup-section,
.dashboard {
  margin-top: 52rpx;
}

.section-heading {
  margin-bottom: 24rpx;
}

.step-label,
.card-label,
.metric-label,
.level-card__label {
  display: block;
  color: #738078;
  font-size: 24rpx;
}

.section-title {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 650;
}

.goal-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.goal-card {
  padding: 30rpx;
  border: 2rpx solid transparent;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(42, 57, 48, 0.04);
}

.goal-card--selected {
  border-color: #2f6b4f;
  background: #f0f7f2;
}

.goal-card__top,
.progress-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.goal-level {
  font-size: 31rpx;
  font-weight: 600;
}

.goal-asset {
  flex-shrink: 0;
  color: #2f6b4f;
  font-size: 28rpx;
  font-weight: 600;
}

.goal-description {
  display: block;
  margin-top: 12rpx;
  color: #747d78;
  font-size: 26rpx;
  line-height: 1.6;
}

.asset-source-note {
  margin-top: 34rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #ecefe8;
}

.asset-source-note__title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.asset-source-note__text {
  display: block;
  margin-top: 8rpx;
  color: #68716c;
  font-size: 25rpx;
  line-height: 1.6;
}

.validation-message {
  display: block;
  margin-top: 18rpx;
  color: #b5473c;
  font-size: 26rpx;
}

.primary-button,
.secondary-button {
  margin-top: 34rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.primary-button {
  color: #ffffff;
  background: #2f6b4f;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

.level-card {
  padding: 44rpx 38rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #275d45, #3f7b5e);
  box-shadow: 0 20rpx 50rpx rgba(47, 107, 79, 0.2);
}

.level-card__label {
  color: rgba(255, 255, 255, 0.75);
}

.level-card__value {
  display: block;
  margin-top: 24rpx;
  font-size: 76rpx;
  font-weight: 700;
  line-height: 1;
}

.level-card__name {
  display: block;
  margin-top: 12rpx;
  font-size: 32rpx;
}

.progress-card {
  margin-top: 28rpx;
  padding: 34rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.card-title {
  display: block;
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.progress-number {
  color: #2f6b4f;
  font-size: 44rpx;
  font-weight: 700;
}

.progress-track {
  height: 18rpx;
  margin-top: 32rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e8ece9;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #d5a94e;
}

.goal-message {
  display: block;
  margin-top: 22rpx;
  color: #69736d;
  font-size: 27rpx;
}

.metric-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 20rpx;
}

.metric-card {
  width: calc(50% - 10rpx);
  padding: 30rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #ffffff;
}

.metric-card--wide {
  width: 100%;
}

.metric-value {
  display: block;
  margin-top: 12rpx;
  font-size: 31rpx;
  font-weight: 600;
}

.recent-card {
  margin-top: 24rpx;
  padding: 34rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.recent-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.recent-title {
  display: block;
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 650;
}

.recent-badge {
  padding: 8rpx 15rpx;
  border-radius: 999rpx;
  color: #745d30;
  background: #f4ead3;
  font-size: 21rpx;
}

.recent-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}

.recent-item {
  width: calc(50% - 8rpx);
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #f5f6f3;
}

.recent-item--wide {
  width: 100%;
}

.recent-label,
.recent-value {
  display: block;
}

.recent-label {
  color: #77817b;
  font-size: 23rpx;
}

.recent-value {
  margin-top: 10rpx;
  color: #26332b;
  font-size: 27rpx;
  font-weight: 600;
}

.recent-value--positive {
  color: #2f6b4f;
}

.recent-value--negative {
  color: #a64138;
}

.secondary-button {
  color: #2f6b4f;
  background: #e6eee8;
}
