.setup-section,
.dashboard {
  margin-top: 44rpx;
}

.section-heading {
  margin-bottom: 24rpx;
}

.step-label,
.metric-label,
.overview-label,
.recent-label {
  display: block;
  color: #738078;
  font-size: 23rpx;
}

.section-title {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 650;
}

.goal-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.goal-card {
  padding: 28rpx;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  background: #ffffff;
}

.goal-card--selected {
  border-color: #2f6b4f;
  background: #f0f7f2;
}

.goal-card__top,
.overview-heading,
.recent-heading,
.progress-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.goal-level {
  font-size: 30rpx;
  font-weight: 600;
}

.goal-asset {
  flex-shrink: 0;
  color: #2f6b4f;
  font-size: 27rpx;
  font-weight: 600;
}

.goal-description {
  display: block;
  margin-top: 10rpx;
  color: #747d78;
  font-size: 25rpx;
  line-height: 1.55;
}

.asset-source-note,
.home-empty-card {
  margin-top: 28rpx;
  padding: 26rpx;
  border-radius: 18rpx;
  background: #ecefe8;
}

.fire-reference-card {
  margin-top: 22rpx;
  padding: 30rpx;
  border: 1rpx solid #e5dfd2;
  border-radius: 22rpx;
  background: #fffdf8;
}

.fire-reference-label,
.fire-reference-title,
.fire-reference-text,
.fire-reference-action {
  display: block;
}

.fire-reference-label {
  color: #987630;
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.fire-reference-title {
  margin-top: 10rpx;
  font-size: 29rpx;
  font-weight: 650;
}

.fire-reference-text {
  margin-top: 9rpx;
  color: #7b817d;
  font-size: 22rpx;
  line-height: 1.55;
}

.fire-reference-action {
  margin-top: 15rpx;
  color: #2f6b4f;
  font-size: 23rpx;
  font-weight: 600;
  text-align: right;
}

.asset-source-note__title,
.home-empty-card__title {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
}

.asset-source-note__text,
.home-empty-card__text {
  display: block;
  margin-top: 8rpx;
  color: #68716c;
  font-size: 24rpx;
  line-height: 1.6;
}

.home-empty-card__action {
  display: block;
  margin-top: 16rpx;
  color: #2f6b4f;
  font-size: 25rpx;
  font-weight: 600;
}

.validation-message {
  display: block;
  margin-top: 18rpx;
  color: #b5473c;
  font-size: 26rpx;
}

.overview-card {
  padding: 34rpx;
  border-radius: 26rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #275d45, #3f7b5e);
  box-shadow: 0 16rpx 42rpx rgba(47, 107, 79, 0.18);
}

.overview-card .overview-label,
.overview-card .metric-label {
  color: rgba(255, 255, 255, 0.62);
}

.level-line {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-top: 10rpx;
}

.overview-level {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1;
}

.overview-level-name,
.goal-summary__value {
  font-size: 26rpx;
  font-weight: 600;
}

.goal-summary {
  text-align: right;
}

.goal-summary__value {
  display: block;
  margin-top: 10rpx;
}

.progress-line {
  margin-top: 30rpx;
}

.progress-track {
  flex: 1;
  height: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #e2b75c;
}

.progress-number {
  min-width: 92rpx;
  font-size: 30rpx;
  font-weight: 700;
  text-align: right;
}

.overview-metrics {
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
}

.overview-metric {
  flex: 1;
}

.overview-metric--center {
  text-align: center;
}

.overview-metric--right {
  text-align: right;
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.recent-card {
  margin-top: 22rpx;
  padding: 30rpx;
  border-radius: 22rpx;
  background: #ffffff;
}

.recent-title {
  display: block;
  margin-top: 7rpx;
  font-size: 30rpx;
  font-weight: 650;
}

.recent-badge {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #745d30;
  background: #f4ead3;
  font-size: 20rpx;
}

.recent-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.recent-item {
  width: calc(50% - 7rpx);
  padding: 21rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #f5f6f3;
}

.recent-item--wide {
  width: 100%;
}

.recent-value {
  display: block;
  margin-top: 9rpx;
  color: #26332b;
  font-size: 25rpx;
  font-weight: 600;
}

.recent-value--positive {
  color: #2f6b4f;
}

.recent-value--negative {
  color: #a64138;
}

.action-row {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.action-button {
  flex: 1;
  margin: 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.primary-button {
  margin-top: 30rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #2f6b4f;
  font-size: 29rpx;
  font-weight: 600;
}

.secondary-button {
  color: #2f6b4f;
  background: #e6eee8;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}
