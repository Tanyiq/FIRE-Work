<view class="page-shell">
  <view class="eyebrow">RETIREMENT PLAN</view>
  <text class="page-title">自由地图</text>
  <text class="page-description">看见财富积累与理想生活之间的距离。</text>

  <view wx:if="{{!hasConfiguration}}" class="setup-section">
    <view class="section-heading">
      <text class="step-label">第一步</text>
      <text class="section-title">选择你的目标生活</text>
    </view>

    <view class="goal-list">
      <view
        wx:for="{{goalOptions}}"
        wx:key="level"
        class="goal-card {{selectedLevel === item.level ? 'goal-card--selected' : ''}}"
        data-level="{{item.level}}"
        bindtap="onSelectGoal"
      >
        <view class="goal-card__top">
          <text class="goal-level">{{item.level}} · {{item.name}}</text>
          <text class="goal-asset">{{item.targetAsset / 10000}} 万元</text>
        </view>
        <text class="goal-description">{{item.description}}</text>
      </view>
    </view>

    <view class="asset-source-note">
      <text class="asset-source-note__title">资产来自财富管家</text>
      <text class="asset-source-note__text">自由进度会根据已录入资产的总额自动更新。</text>
    </view>
    <text wx:if="{{validationMessage}}" class="validation-message">{{validationMessage}}</text>
    <button class="primary-button" bindtap="onSaveConfiguration">生成我的自由地图</button>
  </view>

  <view wx:else class="dashboard">
    <view class="level-card">
      <text class="level-card__label">当前自由等级</text>
      <text class="level-card__value">{{dashboard.currentLevel}}</text>
      <text class="level-card__name">{{dashboard.currentLevelName}}</text>
    </view>

    <view class="progress-card">
      <view class="progress-heading">
        <view>
          <text class="card-label">目标生活</text>
          <text class="card-title">{{dashboard.goal.level}} · {{dashboard.goal.name}}</text>
        </view>
        <text class="progress-number">{{dashboard.progressText}}</text>
      </view>
      <view class="progress-track">
        <view class="progress-fill" style="width: {{dashboard.progressPercent}}%;"></view>
      </view>
      <text class="goal-message" wx:if="{{dashboard.isGoalReached}}">你已经到达这个生活目标。</text>
      <text class="goal-message" wx:else>再积累 {{dashboard.remainingAssetText}}，即可到达目标。</text>
    </view>

    <view class="metric-grid">
      <view class="metric-card">
        <text class="metric-label">当前资产</text>
        <text class="metric-value">{{dashboard.currentAssetText}}</text>
      </view>
      <view class="metric-card">
        <text class="metric-label">目标资产</text>
        <text class="metric-value">{{dashboard.targetAssetText}}</text>
      </view>
      <view class="metric-card metric-card--wide">
        <text class="metric-label">距离目标</text>
        <text class="metric-value">{{dashboard.remainingAssetText}}</text>
      </view>
    </view>

    <view wx:if="{{recentChange}}" class="recent-card">
      <view class="recent-heading">
        <view>
          <text class="card-label">最近变化</text>
          <text class="recent-title">过去一年</text>
        </view>
        <text class="recent-badge">财富成长记录</text>
      </view>
      <view class="recent-grid">
        <view class="recent-item recent-item--wide">
          <text class="recent-label">资产增长</text>
          <text class="recent-value {{recentChange.assetChange >= 0 ? 'recent-value--positive' : 'recent-value--negative'}}">
            {{recentChange.assetChange > 0 ? '+' : ''}}{{recentChange.assetChange}} 元
          </text>
        </view>
        <view class="recent-item">
          <text class="recent-label">自由进度</text>
          <text class="recent-value">{{recentChange.progressFrom}}% → {{recentChange.progressTo}}%</text>
        </view>
        <view class="recent-item">
          <text class="recent-label">人生收藏</text>
          <text class="recent-value">新增 {{recentChange.museumAddedCount}} 件</text>
        </view>
      </view>
    </view>

    <button class="primary-button" bindtap="onGoToWealth">管理我的资产</button>
    <button class="secondary-button" bindtap="onEditConfiguration">调整生活目标</button>
  </view>
</view>
