<page-meta page-style="{{themePageStyle}}"></page-meta>
<view class="page-shell">
  <block wx:if="{{hasConfiguration}}">
    <view class="eyebrow">MY FREEDOM ARCHIVE</view>
    <text class="page-title">我的自由档案</text>
    <text class="page-description">用长期记录，看见自己与梦想生活之间的距离。</text>

    <view class="archive-hero">
      <text class="archive-label">距离梦想生活</text>
      <text wx:if="{{dashboard.isGoalReached}}" class="distance-value">已经抵达</text>
      <text wx:else class="distance-value">还有 {{animatedRemainingProgressText}}</text>
      <view class="level-summary">
        <text class="continuous-level">{{dashboard.continuousLevelText}}</text>
        <text class="stage-name">{{dashboard.accumulationStageName}}</text>
      </view>
      <view class="hero-progress"><view class="hero-progress__fill" style="width: {{animatedProgressPercent}}%;"></view></view>

      <view class="archive-metrics">
        <view class="archive-metric">
          <text class="metric-label">当前资产</text>
          <text class="metric-value">{{animatedCurrentAssetText}}</text>
        </view>
        <view class="archive-metric archive-metric--center">
          <text class="metric-label">过去一年</text>
          <text wx:if="{{recentChange}}" class="metric-value {{recentChange.assetChange >= 0 ? 'metric-value--positive' : 'metric-value--negative'}}">{{recentChange.assetChangeText}}</text>
          <text wx:else class="metric-value">等待记录</text>
        </view>
        <view class="archive-metric archive-metric--right">
          <text class="metric-label">人生收藏</text>
          <text class="metric-value">{{museumCollectionCount}} 件</text>
        </view>
      </view>
      <view class="goal-footer">
        <text>目标 {{dashboard.goal.level}} · {{dashboard.goal.name}}</text>
        <text>{{dashboard.targetAssetText}}</text>
      </view>
    </view>

    <view wx:if="{{showOnboarding}}" class="onboarding-card">
      <view class="onboarding-heading">
        <view>
          <text class="onboarding-eyebrow">GETTING STARTED</text>
          <text class="onboarding-title">完善你的财富档案</text>
        </view>
        <text class="onboarding-progress">{{onboardingCompletedCount}} / 4</text>
      </view>

      <view class="guide-step guide-step--done">
        <text class="step-number">✓</text>
        <view class="step-main"><text class="step-title">选择梦想生活</text><text class="step-text">已选择 {{dashboard.goal.level}} · {{dashboard.goal.name}}</text></view>
        <text class="step-action" bindtap="onEditConfiguration">调整</text>
      </view>
      <view class="guide-step {{hasAssets ? 'guide-step--done' : ''}}">
        <text class="step-number">{{hasAssets ? '✓' : '2'}}</text>
        <view class="step-main"><text class="step-title">记录当前资产</text></view>
        <text wx:if="{{!hasAssets}}" class="step-action" bindtap="onStartAssetGuide">去记录</text>
      </view>
      <view class="guide-step {{hasLivingCost ? 'guide-step--done' : ''}}">
        <text class="step-number">{{hasLivingCost ? '✓' : '3'}}</text>
        <view class="step-main"><text class="step-title">填写生活成本</text></view>
        <text wx:if="{{!hasLivingCost}}" class="step-action" bindtap="onStartLivingCostGuide">去填写</text>
      </view>
      <view class="guide-step guide-step--last {{museumCollectionCount > 0 ? 'guide-step--done' : ''}}">
        <text class="step-number">{{museumCollectionCount > 0 ? '✓' : '4'}}</text>
        <view class="step-main"><text class="step-title">收藏第一段人生经历</text></view>
        <text wx:if="{{museumCollectionCount === 0}}" class="step-action" bindtap="onStartMuseumGuide">去收藏</text>
      </view>
    </view>

    <view wx:else class="archive-complete-card">
      <view class="achievement-mark">✓</view>
      <view class="achievement-main">
        <text class="achievement-title">你的财富档案已建立</text>
        <text class="achievement-text">自由目标 ✓　资产记录 ✓　生活成本 ✓　人生收藏 ✓</text>
      </view>
    </view>

    <view class="advice-entry" bindtap="onGoToAdvice">
      <view>
        <text class="advice-entry__eyebrow">WEALTH GUIDANCE</text>
        <text class="advice-entry__title">查看财富建议中心</text>
      </view>
      <text class="advice-entry__arrow">›</text>
    </view>

    <view class="fire-reference-card" bindtap="onGoToLivingCost">
      <view wx:if="{{balancedFireScenario}}">
        <text class="fire-reference-label">按照你的基础生活成本</text>
        <text class="fire-reference-title">平衡自由预计需要 {{balancedFireScenario.requiredAssetText}}</text>
        <text class="fire-reference-text">按 {{balancedFireScenario.expectedRateText}} 参考收益率估算，仅供规划参考，不替代当前等级目标。</text>
      </view>
      <view wx:else>
        <text class="fire-reference-label">生活成本参考</text>
        <text class="fire-reference-title">完善生活成本，查看平衡自由方案</text>
        <text class="fire-reference-text">生活方式与实现方式，是自由计划的两个维度。</text>
      </view>
      <text class="fire-reference-action">查看分析 →</text>
    </view>

    <view class="action-row">
      <button class="primary-button action-button" bindtap="onGoToWealth">管理资产</button>
      <button class="secondary-button action-button" bindtap="onEditConfiguration">调整目标</button>
    </view>
  </block>

  <block wx:else>
    <view class="eyebrow">CREATE YOUR ARCHIVE</view>
    <text class="page-title">{{isEditingGoal ? '调整梦想生活' : '创建你的财富档案'}}</text>
    <text class="page-description">{{isEditingGoal ? '生活会变化，目标也可以随时重新选择。' : '四个步骤，建立属于你的自由与人生记录。'}}</text>

    <view wx:if="{{!isEditingGoal}}" class="first-guide">
      <view class="guide-step guide-step--active">
        <text class="step-number">1</text>
        <view class="step-main"><text class="step-title">选择梦想生活</text></view>
        <text class="current-badge">当前</text>
      </view>
      <view class="guide-step"><text class="step-number">2</text><view class="step-main"><text class="step-title">记录当前资产</text></view></view>
      <view class="guide-step"><text class="step-number">3</text><view class="step-main"><text class="step-title">填写生活成本</text></view></view>
      <view class="guide-step guide-step--last"><text class="step-number">4</text><view class="step-main"><text class="step-title">收藏第一段人生经历</text></view></view>
    </view>

    <view class="setup-section">
      <text class="setup-kicker">STEP 1</text>
      <text class="section-title">选择你的梦想生活</text>
      <text class="setup-note">等级代表生活质量，之后可以随时调整。</text>
      <view class="goal-list">
        <view wx:for="{{goalOptions}}" wx:key="level" class="goal-card {{selectedLevel === item.level ? 'goal-card--selected' : ''}}" data-level="{{item.level}}" bindtap="onSelectGoal">
          <view class="goal-card__top"><text class="goal-level">{{item.level}} · {{item.name}}</text><text class="goal-asset">{{item.targetAssetText}}</text></view>
          <text class="goal-description">{{item.description}}</text>
        </view>
      </view>
      <text wx:if="{{validationMessage}}" class="validation-message">{{validationMessage}}</text>
      <button class="primary-button" bindtap="onSaveConfiguration">保存并进入下一步</button>
    </view>
  </block>
</view>
