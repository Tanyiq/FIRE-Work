.section-heading {
  margin-top: 36rpx;
}

.section-title,
.cost-label,
.cost-hint,
.summary-label,
.summary-value,
.analysis-title,
.analysis-note,
.scenario-description,
.reference-disclaimer,
.validation-message {
  display: block;
}

.section-title {
  font-size: 31rpx;
  font-weight: 650;
}

.form-card,
.comfortable-card,
.analysis-card {
  margin-top: 18rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(42, 57, 48, 0.05);
}

.form-card {
  padding: 0 32rpx;
}

.cost-row,
.comfortable-card,
.scenario-row,
.scenario-heading,
.cost-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cost-row {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #eceeea;
}

.cost-row--last {
  border-bottom: 0;
}

.cost-label {
  font-size: 28rpx;
  font-weight: 600;
}

.cost-hint {
  margin-top: 7rpx;
  color: #89908c;
  font-size: 21rpx;
}

.input-wrap {
  display: flex;
  align-items: center;
  width: 230rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dfe3de;
  border-radius: 14rpx;
  background: #fafbf9;
  box-sizing: border-box;
}

.cost-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 28rpx;
  text-align: right;
}

.unit {
  margin-left: 8rpx;
  color: #7d8580;
  font-size: 22rpx;
}

.comfortable-card {
  padding: 30rpx 32rpx;
}

.comfortable-input {
  width: 250rpx;
}

.cost-summary {
  margin-top: 24rpx;
  padding: 30rpx 34rpx;
  border-radius: 24rpx;
  color: #ffffff;
  background: linear-gradient(145deg, var(--color-brand-dark), var(--color-brand-end));
}

.summary-right {
  text-align: right;
}

.summary-label {
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
}

.summary-value {
  margin-top: 9rpx;
  font-size: 29rpx;
  font-weight: 650;
}

.analysis-card {
  padding: 34rpx;
}

.analysis-title {
  font-size: 32rpx;
  font-weight: 650;
}

.analysis-note {
  margin-top: 9rpx;
  color: #7d8580;
  font-size: 22rpx;
  line-height: 1.55;
}

.scenario-row {
  gap: 24rpx;
  margin-top: 26rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #eceeea;
}

.scenario-main {
  flex: 1;
  min-width: 0;
}

.scenario-heading {
  justify-content: flex-start;
  gap: 12rpx;
}

.scenario-name {
  font-size: 27rpx;
  font-weight: 600;
}

.scenario-rate {
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  color: #765d2d;
  background: #f5ecd8;
  font-size: 19rpx;
}

.scenario-description {
  margin-top: 8rpx;
  color: #7d8580;
  font-size: 21rpx;
  line-height: 1.5;
}

.scenario-asset {
  flex-shrink: 0;
  color: var(--color-brand);
  font-size: 29rpx;
  font-weight: 700;
}

.reference-disclaimer {
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #eceeea;
  color: #929994;
  font-size: 21rpx;
  line-height: 1.55;
}

.validation-message {
  margin-top: 20rpx;
  color: #b5473c;
  font-size: 24rpx;
  text-align: center;
}

.save-button {
  margin-top: 28rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: var(--color-brand);
  font-size: 28rpx;
  font-weight: 600;
}

.save-button::after {
  border: 0;
}
