<page-meta page-style="{{themePageStyle}}"></page-meta>
<view class="page-shell">
  <view class="eyebrow">LIVING COST</view>
  <text class="page-title">生活成本档案</text>
  <text class="page-description">自由不是一个固定数字，而是不同生活方式和风险选择下的结果。</text>

  <view class="section-heading">
    <text class="section-title">基础生活成本</text>
    <text class="section-note">维持日常生活所需的每月支出</text>
  </view>
  <view class="form-card">
    <view class="cost-row">
      <view>
        <text class="cost-label">房租</text>
        <text class="cost-hint">房租或基础住房成本</text>
      </view>
      <view class="input-wrap">
        <input class="cost-input" type="digit" value="{{form.rent}}" placeholder="0" data-field="rent" bindinput="onAmountInput" />
        <text class="unit">元</text>
      </view>
    </view>
    <view class="cost-row">
      <view>
        <text class="cost-label">饮食</text>
        <text class="cost-hint">日常基本餐饮支出</text>
      </view>
      <view class="input-wrap">
        <input class="cost-input" type="digit" value="{{form.food}}" placeholder="0" data-field="food" bindinput="onAmountInput" />
        <text class="unit">元</text>
      </view>
    </view>
    <view class="cost-row">
      <view>
        <text class="cost-label">交通</text>
        <text class="cost-hint">通勤和基础出行</text>
      </view>
      <view class="input-wrap">
        <input class="cost-input" type="digit" value="{{form.transport}}" placeholder="0" data-field="transport" bindinput="onAmountInput" />
        <text class="unit">元</text>
      </view>
    </view>
    <view class="cost-row cost-row--last">
      <view>
        <text class="cost-label">其他</text>
        <text class="cost-hint">水电、通讯等必要支出</text>
      </view>
      <view class="input-wrap">
        <input class="cost-input" type="digit" value="{{form.other}}" placeholder="0" data-field="other" bindinput="onAmountInput" />
        <text class="unit">元</text>
      </view>
    </view>
  </view>

  <view class="section-heading">
    <text class="section-title">舒适生活成本</text>
    <text class="section-note">包含娱乐、旅行、兴趣和更好的消费</text>
  </view>
  <view class="comfortable-card">
    <view>
      <text class="cost-label">舒适生活总额</text>
      <text class="cost-hint">留空时默认等于基础生活成本</text>
    </view>
    <view class="input-wrap comfortable-input">
      <input class="cost-input" type="digit" value="{{form.comfortableMonthlyCost}}" placeholder="0" data-field="comfortableMonthlyCost" bindinput="onAmountInput" />
      <text class="unit">元/月</text>
    </view>
  </view>

  <view class="cost-summary">
    <view>
      <text class="summary-label">基础生活</text>
      <text class="summary-value">{{essentialMonthlyCostText}} / 月</text>
    </view>
    <view class="summary-right">
      <text class="summary-label">舒适生活</text>
      <text class="summary-value">{{comfortableMonthlyCostText}} / 月</text>
    </view>
  </view>

  <view wx:if="{{fireScenarios.length > 0}}" class="analysis-card">
    <text class="analysis-title">自由成本分析</text>
    <text class="analysis-note">以下方案均按基础生活成本计算，只代表不同实现方式。</text>
    <view wx:for="{{fireScenarios}}" wx:key="id" class="scenario-row">
      <view class="scenario-main">
        <view class="scenario-heading">
          <text class="scenario-name">{{item.name}}</text>
          <text class="scenario-rate">参考 {{item.expectedRateText}}</text>
        </view>
        <text class="scenario-description">{{item.description}}</text>
      </view>
      <text class="scenario-asset">{{item.requiredAssetText}}</text>
    </view>
    <text class="reference-disclaimer">方案仅用于长期规划参考，不构成收益承诺或投资建议，也不会修改你的 Lv1–Lv4 目标。</text>
  </view>

  <text wx:if="{{validationMessage}}" class="validation-message">{{validationMessage}}</text>
  <button class="save-button" bindtap="onSave">保存生活成本</button>
</view>
