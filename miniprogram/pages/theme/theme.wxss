.preview-card {
  margin-top: 40rpx;
  padding: 38rpx 34rpx;
  border-radius: var(--radius-lg);
  color: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(40, 46, 58, 0.18);
}

.preview-label,
.preview-title,
.section-title,
.section-description,
.preset-name,
.preset-color,
.validation-message {
  display: block;
}

.preview-label {
  color: rgba(255, 255, 255, 0.66);
  font-size: 21rpx;
}

.preview-title {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.45;
}

.preview-progress {
  height: 12rpx;
  margin-top: 30rpx;
  overflow: hidden;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.2);
}

.preview-progress__fill {
  width: 68%;
  height: 100%;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.86);
}

.theme-card {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: var(--radius-md);
  background: #ffffff;
}

.section-title {
  font-size: 31rpx;
  font-weight: 650;
}

.section-description {
  margin-top: 10rpx;
  color: #727c76;
  font-size: 22rpx;
  line-height: 1.55;
}

.preset-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.preset-item {
  width: calc(50% - 8rpx);
  padding: 20rpx;
  border: 2rpx solid #eceeea;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.preset-item--selected {
  border-color: var(--color-brand);
  background: var(--color-brand-surface);
}

.preset-swatch,
.input-swatch {
  width: 50rpx;
  height: 50rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 0 0 1rpx rgba(36, 48, 41, 0.13);
}

.preset-name {
  margin-top: 14rpx;
  font-size: 25rpx;
  font-weight: 650;
}

.preset-color {
  margin-top: 5rpx;
  color: #89908c;
  font-size: 19rpx;
}

.color-input-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 18rpx 22rpx;
  border: 2rpx solid #e3e5e1;
  border-radius: 18rpx;
}

.input-swatch {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
}

.color-input {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.validation-message {
  margin-top: 16rpx;
  color: #a64138;
  font-size: 23rpx;
}

.save-button {
  margin-top: 26rpx;
  border-radius: var(--radius-pill);
  color: #ffffff;
  background: var(--color-brand);
  font-size: 28rpx;
  font-weight: 650;
}
