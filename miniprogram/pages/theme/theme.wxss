.preview-card {
  margin-top: 28rpx;
  padding: 30rpx;
  border-radius: var(--radius-lg);
  color: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(40, 46, 58, 0.18);
}

.preview-label,
.preview-title,
.section-title,
.custom-label,
.preset-name,
.preset-color,
.validation-message {
  display: block;
}

.preview-label {
  color: rgba(255, 255, 255, 0.66);
  font-size: 21rpx;
}

.preview-title {
  margin-top: 8rpx;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.45;
}

.preview-progress {
  height: 10rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.2);
}

.preview-progress__fill {
  width: 68%;
  height: 100%;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.86);
}

.theme-card {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: var(--radius-md);
  background: #ffffff;
}

.section-title {
  font-size: 31rpx;
  font-weight: 650;
}

.preview-custom-panel {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.94);
}

.custom-label {
  color: #56615b;
  font-size: 23rpx;
  font-weight: 600;
}

.preset-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  row-gap: 14rpx;
  margin-top: 20rpx;
}

.preset-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
  width: 48.5%;
  min-height: 84rpx;
  padding: 14rpx 16rpx;
  border: 2rpx solid #eceeea;
  border-radius: 18rpx;
}

.preset-item--selected {
  border-color: var(--color-brand);
  background: var(--color-brand-surface);
}

.preset-swatch,
.input-swatch {
  width: 42rpx;
  height: 42rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 0 0 1rpx rgba(36, 48, 41, 0.13);
}

.preset-copy {
  min-width: 0;
}

.preset-name {
  font-size: 23rpx;
  font-weight: 650;
}

.preset-color {
  margin-top: 3rpx;
  color: #89908c;
  font-size: 19rpx;
}

.color-input-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  border: 2rpx solid #e3e5e1;
  border-radius: 18rpx;
}

.input-swatch {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
}

.color-input {
  flex: 1;
  min-width: 0;
  color: #29332e;
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.validation-message {
  margin-top: 16rpx;
  color: #a64138;
  font-size: 23rpx;
}

.save-button {
  margin-top: 18rpx;
  border-radius: var(--radius-pill);
  background: #ffffff;
  box-shadow: 0 0 0 2rpx currentColor inset;
  font-size: 28rpx;
  font-weight: 650;
}
