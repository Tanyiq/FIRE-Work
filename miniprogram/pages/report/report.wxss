.report-content {
  margin-top: 44rpx;
}

.annual-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 34rpx;
  padding: 30rpx 32rpx;
  border-radius: 24rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #654f2b, #9a7740);
}

.annual-entry__eyebrow,
.annual-entry__title {
  display: block;
}

.annual-entry__eyebrow {
  color: rgba(255, 255, 255, 0.62);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.annual-entry__title {
  margin-top: 8rpx;
  font-size: 29rpx;
  font-weight: 650;
}

.annual-entry__arrow {
  margin-left: 18rpx;
  color: #f0d39b;
  font-size: 46rpx;
}

.report-status {
  display: flex;
  justify-content: space-between;
  margin-top: 34rpx;
  padding: 20rpx 26rpx;
  border-radius: 16rpx;
  color: #6d7771;
  background: #ecefe9;
  font-size: 23rpx;
}

.empty-card,
.report-card,
.summary-card {
  margin-top: 28rpx;
  padding: 36rpx;
  border-radius: 26rpx;
  background: #ffffff;
}

.empty-card {
  margin-top: 48rpx;
  padding: 56rpx 38rpx;
  text-align: center;
}

.baseline-card {
  margin-top: 32rpx;
  padding: 48rpx 38rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(150deg, #2b4437, var(--color-brand-end));
  text-align: center;
}

.baseline-card__eyebrow,
.baseline-card__value,
.baseline-card__date,
.baseline-card__text {
  display: block;
}

.baseline-card__eyebrow {
  color: rgba(255, 255, 255, 0.68);
  font-size: 23rpx;
  letter-spacing: 3rpx;
}

.baseline-card__value {
  margin-top: 26rpx;
  font-size: 54rpx;
  font-weight: 700;
}

.baseline-card__date {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.65);
  font-size: 24rpx;
}

.baseline-card__text {
  margin-top: 34rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
  line-height: 1.7;
}

.secondary-button {
  margin-top: 34rpx;
  border-radius: 999rpx;
  color: var(--color-brand);
  background: #ffffff;
  font-size: 28rpx;
}

.secondary-button::after {
  border: 0;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 650;
}

.empty-text {
  display: block;
  margin-top: 16rpx;
  color: #747d78;
  font-size: 26rpx;
  line-height: 1.6;
}

.report-cover {
  padding: 48rpx 38rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(150deg, var(--color-brand-dark), var(--color-brand-end));
}

.report-cover__label {
  color: rgba(255, 255, 255, 0.65);
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.report-cover__title {
  display: block;
  margin-top: 28rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.report-cover__period {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 25rpx;
}

.section-index {
  display: block;
  color: #d5a94e;
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.section-title {
  display: block;
  margin-top: 8rpx;
  font-size: 33rpx;
  font-weight: 650;
}

.comparison-row,
.level-flow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 30rpx;
}

.comparison-item {
  flex: 1;
}

.comparison-item--right,
.level-flow__current {
  text-align: right;
}

.metric-label,
.section-hint {
  display: block;
  color: #77817b;
  font-size: 24rpx;
}

.metric-value {
  display: block;
  margin-top: 9rpx;
  font-size: 29rpx;
  font-weight: 600;
}

.comparison-arrow,
.level-arrow {
  padding: 0 22rpx;
  color: #a3aaa6;
}

.change-highlight {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.change-highlight--positive {
  color: var(--color-brand);
  background: var(--color-brand-soft);
}

.change-highlight--negative {
  color: #a64138;
  background: #f8e9e7;
}

.level-name,
.level-progress {
  display: block;
}

.level-name {
  font-size: 40rpx;
  font-weight: 700;
}

.level-progress {
  margin-top: 8rpx;
  color: #647069;
  font-size: 26rpx;
}

.distance-note {
  display: block;
  margin-top: 28rpx;
  color: var(--color-brand);
  font-size: 27rpx;
}

.section-hint {
  margin-top: 24rpx;
}

.source-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.source-chip {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  color: #68716c;
  background: #f0f1ed;
  font-size: 25rpx;
}

.source-chip--selected {
  color: #ffffff;
  background: var(--color-brand);
}

.museum-empty {
  margin-top: 24rpx;
  color: #7a817d;
  font-size: 26rpx;
}

.museum-item {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #eceeea;
}

.museum-name,
.museum-type,
.museum-story {
  display: block;
}

.museum-name {
  font-size: 29rpx;
  font-weight: 600;
}

.museum-type {
  margin-top: 7rpx;
  color: var(--color-brand);
  font-size: 24rpx;
}

.museum-story {
  margin-top: 12rpx;
  color: #747d78;
  font-size: 25rpx;
  line-height: 1.6;
}

.summary-card {
  color: #ffffff;
  background: var(--color-brand-dark);
}

.section-index--light,
.source-note {
  color: rgba(255, 255, 255, 0.6);
}

.summary-text {
  display: block;
  margin-top: 26rpx;
  font-size: 29rpx;
  line-height: 1.75;
}

.source-note {
  display: block;
  margin-top: 24rpx;
  font-size: 23rpx;
}

.primary-button {
  margin-top: 30rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: var(--color-brand);
  font-size: 29rpx;
  font-weight: 600;
}

.primary-button::after {
  border: 0;
}

.generated-message {
  display: block;
  margin-top: 26rpx;
  color: var(--color-brand);
  text-align: center;
  font-size: 25rpx;
}
