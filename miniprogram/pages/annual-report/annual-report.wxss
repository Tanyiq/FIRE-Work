.top-row,
.wealth-flow,
.growth-highlight,
.habit-grid,
.life-highlight {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.year-picker {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border-radius: var(--radius-pill);
  color: #2f6b4f;
  color: var(--color-brand);
  background: #e7eee9;
  background: var(--color-brand-soft);
  font-size: 23rpx;
}

.cover-card {
  margin-top: 40rpx;
  padding: 52rpx 38rpx;
  border-radius: 28rpx;
  color: #ffffff;
  background: linear-gradient(150deg, #5b4828, #a17a3b);
  box-shadow: 0 18rpx 45rpx rgba(91, 72, 40, 0.2);
}

.cover-year,
.cover-title,
.cover-subtitle,
.section-index,
.section-title,
.metric-label,
.metric-value,
.freedom-level,
.freedom-note,
.habit-number,
.habit-label,
.life-name,
.life-meta,
.investment-count,
.lesson-label,
.lesson-text,
.disclaimer {
  display: block;
}

.cover-year {
  color: #f0d39b;
  font-size: 66rpx;
  font-weight: 750;
  line-height: 1;
}

.cover-title {
  margin-top: 22rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.cover-subtitle {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 19rpx;
  letter-spacing: 2rpx;
}

.share-button {
  margin-top: 22rpx;
  border-radius: 999rpx;
  color: #6f562b;
  background: #f0dfb8;
  font-size: 26rpx;
  font-weight: 600;
}

.share-button::after {
  border: 0;
}

.share-canvas {
  position: fixed;
  top: 0;
  left: -9999px;
  width: 600px;
  height: 800px;
}

.report-card,
.investment-card {
  margin-top: 24rpx;
  padding: 34rpx;
  border-radius: 24rpx;
  border-radius: var(--radius-md);
  background: #ffffff;
  background: var(--color-surface);
}

.report-switching .cover-card,
.report-switching .report-card,
.report-switching .investment-card {
  animation: report-switch-in 340ms ease-out both;
}

.report-switching .report-card:nth-of-type(3) {
  animation-delay: 35ms;
}

.report-switching .report-card:nth-of-type(4),
.report-switching .investment-card {
  animation-delay: 70ms;
}

@keyframes report-switch-in {
  from {
    opacity: 0;
    transform: translateY(14rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.section-index {
  color: #bd8e3f;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.section-title {
  margin-top: 7rpx;
  font-size: 32rpx;
  font-weight: 650;
}

.wealth-flow {
  margin-top: 28rpx;
}

.align-right {
  text-align: right;
}

.metric-label {
  color: #7c847f;
  font-size: 22rpx;
}

.metric-value {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.flow-arrow {
  color: #a5aba7;
  font-size: 30rpx;
}

.growth-highlight {
  margin-top: 25rpx;
  padding: 21rpx 23rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 650;
}

.growth-highlight--positive {
  color: #2f6b4f;
  background: #e8f1eb;
}

.growth-highlight--negative {
  color: #a64138;
  background: #f8e9e7;
}

.section-empty {
  margin-top: 24rpx;
  padding: 27rpx;
  border-radius: 17rpx;
  color: #7c847f;
  background: #f5f6f3;
  font-size: 23rpx;
  line-height: 1.6;
}

.empty-action {
  display: block;
  margin-top: 10rpx;
  color: #2f6b4f;
  font-weight: 600;
}

.freedom-flow {
  margin-top: 26rpx;
  text-align: center;
}

.freedom-level {
  font-size: 43rpx;
  font-weight: 700;
}

.freedom-level--current {
  color: #2f6b4f;
}

.freedom-arrow {
  display: block;
  margin: 12rpx 0;
  color: #bd8e3f;
  font-size: 36rpx;
}

.freedom-note {
  margin-top: 20rpx;
  color: #8b928e;
  font-size: 20rpx;
  line-height: 1.55;
  text-align: center;
}

.habit-grid {
  margin-top: 28rpx;
}

.habit-item {
  flex: 1;
  text-align: center;
}

.habit-number {
  color: #2f6b4f;
  font-size: 39rpx;
  font-weight: 700;
}

.habit-label {
  margin-top: 7rpx;
  color: #7c847f;
  font-size: 20rpx;
}

.life-highlight {
  justify-content: flex-start;
  gap: 25rpx;
  margin-top: 26rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #fff8e9;
}

.life-icon {
  flex-shrink: 0;
  font-size: 54rpx;
}

.life-name {
  font-size: 29rpx;
  font-weight: 650;
}

.life-meta {
  margin-top: 7rpx;
  color: #7c725f;
  font-size: 22rpx;
}

.investment-card {
  color: #ffffff;
  background: #2d493b;
}

.section-index--light {
  color: #e2bd6d;
}

.investment-count {
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 23rpx;
}

.lesson-block {
  margin-top: 25rpx;
  padding: 27rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.08);
}

.lesson-label {
  color: #e2bd6d;
  font-size: 20rpx;
}

.lesson-text {
  margin-top: 13rpx;
  font-size: 28rpx;
  line-height: 1.65;
}

.investment-empty {
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.65);
  font-size: 23rpx;
  line-height: 1.6;
}

.investment-action {
  display: block;
  margin-top: 10rpx;
  color: #e2bd6d;
  font-weight: 600;
}

.disclaimer {
  margin-top: 28rpx;
  color: #999f9b;
  font-size: 20rpx;
  line-height: 1.6;
  text-align: center;
}
