<page-meta page-style="{{themePageStyle}}"></page-meta>
<view class="page-shell">
  <view class="eyebrow">WEALTH GUIDANCE</view>
  <text class="page-title">财富建议中心</text>
  <text class="page-description">从你已经记录的事实中理解当前状态，而不是预测市场或给出买卖答案。</text>

  <view class="state-card">
    <text class="state-label">你的财富状态</text>
    <text class="state-title">{{report.stateType}}</text>
    <text class="state-summary">{{report.summary}}</text>
    <text class="state-asset">当前总资产 {{report.totalAssetText}}</text>
  </view>

  <view class="metrics-card">
    <view class="metric-item">
      <text class="metric-label">过去一年</text>
      <text class="metric-value">{{report.yearGrowthText}}</text>
    </view>
    <view class="metric-item metric-item--right">
      <text class="metric-label">安全储备</text>
      <text class="metric-value">{{report.safetyMonthsText}}</text>
    </view>
    <view class="metric-item">
      <text class="metric-label">安全资产</text>
      <text class="metric-value">{{report.safeAssetRatioText}}</text>
    </view>
    <view class="metric-item metric-item--right">
      <text class="metric-label">投资复盘</text>
      <text class="metric-value">{{report.investmentRecordCount}} 条</text>
    </view>
    <view class="update-row">
      <text>资产最近更新</text>
      <text>{{report.lastAssetUpdateText}}</text>
    </view>
  </view>

  <view class="advice-section">
    <view class="section-heading">
      <text class="section-title">优势</text>
      <text class="section-count">{{report.advantages.length}} 项</text>
    </view>
    <view wx:for="{{report.advantages}}" wx:key="id" class="advice-item advice-item--good">
      <text class="advice-icon">✓</text>
      <view class="advice-main">
        <view class="advice-heading">
          <text class="advice-title">{{item.title}}</text>
          <text class="source-badge">{{item.sourceLabel}}</text>
        </view>
        <text class="advice-message">{{item.message}}</text>
      </view>
    </view>
  </view>

  <view class="advice-section">
    <view class="section-heading">
      <text class="section-title">关注</text>
      <text class="section-count">{{report.concerns.length}} 项</text>
    </view>
    <view wx:if="{{report.concerns.length === 0}}" class="all-clear">当前没有需要特别提示的规则项，继续保持定期记录。</view>
    <view wx:for="{{report.concerns}}" wx:key="id" class="advice-item advice-item--attention">
      <text class="advice-icon">!</text>
      <view class="advice-main">
        <view class="advice-heading">
          <text class="advice-title">{{item.title}}</text>
          <text class="source-badge">{{item.sourceLabel}}</text>
        </view>
        <text class="advice-message">{{item.message}}</text>
      </view>
    </view>
  </view>

  <view class="action-card">
    <text class="action-title">让建议保持准确</text>
    <text class="action-text">定期更新资产、生活成本，并为真实的投资经历留下复盘。</text>
    <view class="action-links">
      <text bindtap="onGoToWealth">更新资产</text>
      <text bindtap="onGoToLivingCost">生活成本</text>
      <text bindtap="onGoToInvestment">投资复盘</text>
    </view>
  </view>

  <text class="disclaimer">本页只对用户自行记录的数据进行规则归纳，不构成投资建议，不推荐标的，不判断市场位置，也不预测收益。</text>
</view>
