.setting-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 34rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(42, 57, 48, 0.05);
}

.archive-card {
  margin-top: 42rpx;
  padding: 34rpx;
  border-radius: 26rpx;
  color: #ffffff;
  background: linear-gradient(145deg, var(--color-brand-dark), var(--color-brand-end));
  box-shadow: 0 16rpx 42rpx rgba(42, 57, 48, 0.16);
}

.archive-eyebrow,
.archive-joined__label,
.archive-joined__value,
.archive-number,
.archive-label {
  display: block;
}

.archive-eyebrow {
  color: rgba(255, 255, 255, 0.58);
  font-size: 21rpx;
  letter-spacing: 2rpx;
}

.archive-joined {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 18rpx;
}

.archive-joined__label {
  font-size: 28rpx;
  font-weight: 600;
}

.archive-joined__value {
  font-size: 38rpx;
  font-weight: 700;
}

.archive-grid {
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.15);
}

.archive-item {
  flex: 1;
}

.archive-item--right {
  text-align: right;
}

.archive-number {
  font-size: 30rpx;
  font-weight: 700;
}

.archive-label {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 20rpx;
}

.setting-card--secondary {
  margin-top: 16rpx;
}

.setting-main {
  flex: 1;
  min-width: 0;
}

.setting-title,
.setting-amount,
.setting-empty,
.privacy-title,
.privacy-text {
  display: block;
}

.setting-title {
  font-size: 31rpx;
  font-weight: 650;
}

.setting-value {
  display: flex;
  align-items: center;
  margin-left: 24rpx;
}

.setting-amount {
  color: var(--color-brand);
  font-size: 25rpx;
  font-weight: 600;
}

.setting-empty {
  color: #929994;
  font-size: 24rpx;
}

.setting-arrow {
  margin-left: 12rpx;
  color: #a7ada9;
  font-size: 42rpx;
  line-height: 1;
}

.theme-swatch {
  width: 38rpx;
  height: 38rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 0 0 1rpx rgba(36, 48, 41, 0.14);
}

.privacy-card {
  margin-top: 24rpx;
  padding: 30rpx 34rpx;
  border: 1rpx solid #e7e4db;
  border-radius: 22rpx;
}

.privacy-title {
  font-size: 26rpx;
  font-weight: 600;
}

.privacy-text {
  margin-top: 10rpx;
  color: #7a817d;
  font-size: 23rpx;
  line-height: 1.6;
}
