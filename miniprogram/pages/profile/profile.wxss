.setting-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 48rpx;
  padding: 34rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(42, 57, 48, 0.05);
}

.setting-main {
  flex: 1;
  min-width: 0;
}

.setting-title,
.setting-description,
.setting-amount,
.setting-empty,
.privacy-title,
.privacy-text {
  display: block;
}

.setting-title {
  font-size: 31rpx;
  font-weight: 650;
}

.setting-description {
  margin-top: 10rpx;
  color: #78817c;
  font-size: 23rpx;
  line-height: 1.5;
}

.setting-value {
  display: flex;
  align-items: center;
  margin-left: 24rpx;
}

.setting-amount {
  color: #2f6b4f;
  font-size: 25rpx;
  font-weight: 600;
}

.setting-empty {
  color: #929994;
  font-size: 24rpx;
}

.setting-arrow {
  margin-left: 12rpx;
  color: #a7ada9;
  font-size: 42rpx;
  line-height: 1;
}

.privacy-card {
  margin-top: 24rpx;
  padding: 30rpx 34rpx;
  border: 1rpx solid #e7e4db;
  border-radius: 22rpx;
}

.privacy-title {
  font-size: 26rpx;
  font-weight: 600;
}

.privacy-text {
  margin-top: 10rpx;
  color: #7a817d;
  font-size: 23rpx;
  line-height: 1.6;
}
