<page-meta page-style="{{themePageStyle}}"></page-meta>
<view class="page-shell">
  <view class="eyebrow">WEALTH</view>
  <text class="page-title">财富管家</text>

  <view wx:if="{{isGuidedAssetStep}}" class="guide-focus-card">
    <view class="guide-focus-card__top">
      <text class="guide-focus-card__step">STEP 2 / 4</text>
      <text class="guide-focus-card__exit" hover-class="tap-text--active" bindtap="onExitGuide">暂时退出引导</text>
    </view>
    <text class="guide-focus-card__title">{{guidedAssetCompleted ? '资产基线已建立' : '记录第一项资产'}}</text>
    <text class="guide-focus-card__text">{{guidedAssetCompleted ? '下一步填写生活成本，用于评估安全储备。' : '先记录一项真实资产。保存后会自动进入下一步，不会跳去其他功能。'}}</text>
    <button wx:if="{{guidedAssetCompleted}}" class="guide-focus-card__button" bindtap="onContinueGuide">继续填写生活成本</button>
  </view>

  <view wx:if="{{!isGuidedAssetStep}}" class="total-card">
    <text class="total-card__label">当前总资产</text>
    <view class="total-card__amount-row">
      <text class="total-card__amount">{{totalAssetText}}</text>
    </view>
  </view>

  <view wx:if="{{!isGuidedAssetStep}}" class="health-entry advice-center-entry" hover-class="tap-card--active" bindtap="onGoToAdvice">
    <view>
      <text class="health-entry__eyebrow">WEALTH GUIDANCE</text>
      <text class="health-entry__title">财富建议中心</text>
    </view>
    <text class="health-entry__arrow">›</text>
  </view>

  <view wx:if="{{!isGuidedAssetStep}}" class="health-entry" hover-class="tap-card--active" bindtap="onGoToHealth">
    <view>
      <text class="health-entry__eyebrow">WEALTH HEALTH</text>
      <text class="health-entry__title">查看财富体检报告</text>
    </view>
    <text class="health-entry__arrow">›</text>
  </view>

  <view wx:if="{{!isGuidedAssetStep}}" class="health-entry investment-entry" hover-class="tap-card--active" bindtap="onGoToInvestment">
    <view>
      <text class="health-entry__eyebrow">INVESTMENT REVIEW</text>
      <text class="health-entry__title">进入投资复盘馆</text>
    </view>
    <text class="health-entry__arrow">›</text>
  </view>

  <view wx:if="{{!isGuidedAssetStep}}" class="trend-card">
    <view class="trend-heading">
      <view>
        <text class="trend-title">资产成长曲线</text>
      </view>
      <view class="range-switch">
        <text class="range-option {{trendRange === 'month' ? 'range-option--active' : ''}}" hover-class="tap-text--active" data-range="month" bindtap="onTrendRangeChange">月</text>
        <text class="range-option {{trendRange === 'year' ? 'range-option--active' : ''}}" hover-class="tap-text--active" data-range="year" bindtap="onTrendRangeChange">年</text>
      </view>
    </view>
    <view wx:if="{{trendPoints.length > 1}}">
      <canvas canvas-id="wealthTrendCanvas" class="trend-canvas"></canvas>
      <view class="trend-metrics">
        <text>起点 {{trendStartAssetText}}</text>
        <text class="trend-change {{trendChange >= 0 ? 'trend-change--positive' : 'trend-change--negative'}}">
          {{trendChangeText}}
        </text>
        <text>当前 {{trendEndAssetText}}</text>
      </view>
    </view>
    <view wx:elif="{{trendPoints.length === 1}}" class="trend-baseline">
      <text class="trend-baseline__label">已记录第一份财富基线</text>
      <text class="trend-baseline__value">{{trendEndAssetText}}</text>
    </view>
    <view wx:else class="trend-empty">添加资产后，将从第一份财富快照开始记录趋势。</view>
  </view>

  <view wx:if="{{!isGuidedAssetStep}}" class="asset-section">
    <text class="section-title">资产分类</text>
    <view wx:if="{{categories.length === 0}}" class="empty-card">
      <text class="empty-title">建立第一份资产基线</text>
      <text class="empty-text">记录一项真实资产，自由进度和财富趋势会从这里开始。</text>
    </view>

    <view wx:for="{{categories}}" wx:key="value" class="category-card">
      <view class="category-heading">
        <text class="category-name">{{item.label}}</text>
        <text class="category-total">{{item.totalAmountText}}</text>
      </view>
      <view
        wx:for="{{item.assets}}"
        wx:for-item="asset"
        wx:key="id"
        class="asset-row"
      >
        <text class="asset-name">{{asset.name}}</text>
        <view class="asset-row__right">
          <text class="asset-amount">{{asset.currentAmountText}}</text>
          <text class="edit-action" hover-class="tap-text--active" data-id="{{asset.id}}" bindtap="onEditAsset">编辑</text>
          <text class="delete-action" hover-class="tap-text--active" data-id="{{asset.id}}" bindtap="onDeleteAsset">删除</text>
        </view>
      </view>
    </view>
  </view>

  <view id="assetForm" wx:if="{{showAssetForm}}" class="asset-form asset-form--focused">
    <text class="form-title">{{editingAssetId ? '修改资产' : '记录一项资产'}}</text>
    <text class="field-label">资产类型</text>
    <picker mode="selector" range="{{assetTypeOptions}}" range-key="label" value="{{selectedTypeIndex}}" bindchange="onTypeChange">
      <view class="picker-field"><text>{{selectedTypeLabel}}</text><text class="picker-arrow">选择 ›</text></view>
    </picker>
    <text class="field-label">资产名称</text>
    <input class="text-field" value="{{assetNameInput}}" placeholder="例如：招商银行活期" bindinput="onNameInput" />
    <text class="field-label">当前金额</text>
    <view class="amount-field"><input class="amount-input" type="digit" value="{{assetAmountInput}}" placeholder="例如 20" bindinput="onAmountInput" /><text class="amount-unit">万元</text></view>
    <text wx:if="{{validationMessage}}" class="validation-message">{{validationMessage}}</text>
    <button class="save-button" bindtap="onAddAsset">{{editingAssetId ? '保存修改' : (isGuidedAssetStep ? '保存并进入下一步' : '保存资产')}}</button>
  </view>

  <button wx:if="{{!isGuidedAssetStep}}" class="add-button page-bottom-action" bindtap="onToggleAssetForm">
    {{showAssetForm ? '收起录入' : (totalAsset > 0 ? '+ 新增资产' : '+ 添加第一项资产')}}
  </button>
</view>
