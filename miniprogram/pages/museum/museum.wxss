.add-button,
.save-button {
  border-radius: 999rpx;
  color: #ffffff;
  background: var(--color-brand);
  font-size: 30rpx;
  font-weight: 600;
}

.add-button {
  margin-top: 42rpx;
}

.add-button::after,
.save-button::after,
.edit-button::after,
.delete-button::after {
  border: 0;
}

.collection-form,
.detail-card {
  margin-top: 26rpx;
  padding: 34rpx;
  border-radius: 26rpx;
  background: #ffffff;
}

.form-title,
.section-title {
  font-size: 34rpx;
  font-weight: 650;
}

.field-label {
  display: block;
  margin-top: 28rpx;
  margin-bottom: 12rpx;
  color: #68716c;
  font-size: 25rpx;
}

.picker-field,
.text-field,
.story-field {
  box-sizing: border-box;
  width: 100%;
  padding: 0 26rpx;
  border: 2rpx solid #e0e2dd;
  border-radius: 18rpx;
  background: #fafbf9;
}

.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 92rpx;
  line-height: 1;
}

.picker-field > text {
  display: flex;
  align-items: center;
  height: 100%;
  line-height: 1;
}

.text-field {
  height: 92rpx;
}

.story-field {
  min-height: 190rpx;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.picker-arrow {
  color: #7a817d;
  font-size: 25rpx;
}

.status-selector {
  display: flex;
  gap: 14rpx;
  padding: 8rpx;
  border: 2rpx solid #e0e2dd;
  border-radius: 18rpx;
  background: #fafbf9;
}

.status-option {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex: 1;
  height: 76rpx;
  border-radius: 13rpx;
  color: #68716c;
  font-size: 26rpx;
  line-height: 1;
  text-align: center;
}

.status-option--selected {
  color: var(--color-brand);
  background: var(--color-brand-soft);
  font-weight: 600;
}

.validation-message {
  display: block;
  margin-top: 18rpx;
  color: #b5473c;
  font-size: 26rpx;
}

.save-button {
  margin-top: 30rpx;
}

.empty-card {
  margin-top: 48rpx;
  padding: 64rpx 36rpx;
  border-radius: 26rpx;
  background: #ffffff;
  text-align: center;
}

.empty-symbol {
  display: block;
  color: #d5a94e;
  font-size: 64rpx;
}

.empty-title {
  display: block;
  margin-top: 20rpx;
  font-size: 31rpx;
  font-weight: 600;
}

.empty-text {
  display: block;
  margin-top: 12rpx;
  color: #7a817d;
  font-size: 26rpx;
  line-height: 1.6;
}

.collection-section {
  margin-top: 48rpx;
}

.museum-tabs {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
  padding: 8rpx;
  border-radius: 18rpx;
  background: #eceeea;
}

.museum-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex: 1;
  height: 72rpx;
  border-radius: 13rpx;
  color: #68716c;
  font-size: 26rpx;
  line-height: 1;
  text-align: center;
}

.museum-tab--selected {
  color: var(--color-brand);
  background: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(42, 57, 48, 0.08);
  font-weight: 600;
}

.category-empty {
  margin-top: 22rpx;
  padding: 52rpx 24rpx;
  border-radius: 20rpx;
  color: #858d88;
  background: #ffffff;
  font-size: 25rpx;
  text-align: center;
}

.section-heading,
.detail-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.collection-count {
  color: #7a817d;
  font-size: 25rpx;
}

.collection-card {
  margin-top: 22rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 32rpx rgba(42, 57, 48, 0.05);
  overflow: hidden;
}

.collection-photo {
  display: block;
  width: calc(100% + 64rpx);
  height: 300rpx;
  margin: -32rpx -32rpx 28rpx;
}

.detail-photo {
  display: block;
  width: calc(100% + 68rpx);
  height: 390rpx;
  margin: -34rpx -34rpx 30rpx;
  border-radius: 26rpx 26rpx 0 0;
}

.photo-preview {
  position: relative;
  overflow: hidden;
  border-radius: 20rpx;
}

.photo-preview__image {
  display: block;
  width: 100%;
  height: 340rpx;
}

.photo-remove {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: rgba(31, 42, 36, 0.72);
  font-size: 22rpx;
}

.photo-button {
  border: 2rpx dashed var(--color-brand);
  border-radius: 18rpx;
  color: var(--color-brand);
  background: var(--color-brand-surface);
  font-size: 26rpx;
}

.type-badge,
.status-badge {
  display: inline-block;
  box-sizing: border-box;
  flex-shrink: 0;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: var(--color-brand);
  background: var(--color-brand-soft);
  font-size: 23rpx;
  line-height: 48rpx;
  text-align: center;
  vertical-align: middle;
  white-space: nowrap;
}

.collection-name,
.detail-title {
  display: block;
  color: #253229;
  font-weight: 650;
}

.collection-name {
  margin-top: 0;
  font-size: 34rpx;
}

.detail-story {
  display: -webkit-box;
  overflow: hidden;
  color: #737c77;
  line-height: 1.65;
  -webkit-box-orient: vertical;
}

.collection-summary {
  display: flex;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #eceeea;
}

.collection-summary__item {
  flex: 1;
  min-width: 0;
}

.collection-summary__item--center {
  text-align: center;
}

.collection-summary__item--right {
  text-align: right;
}

.collection-summary__label,
.collection-summary__value {
  display: block;
}

.collection-summary__label {
  color: #8a918d;
  font-size: 20rpx;
}

.collection-summary__value {
  margin-top: 8rpx;
  color: #4f5b54;
  font-size: 23rpx;
  font-weight: 600;
  white-space: nowrap;
}

.detail-section {
  margin-top: 38rpx;
}

.back-action {
  color: var(--color-brand);
  font-size: 27rpx;
}

.status-badge--retired {
  color: #745d30;
  background: #f4ead3;
}

.detail-title {
  margin-top: 34rpx;
  font-size: 44rpx;
}

.detail-story {
  margin-top: 18rpx;
  font-size: 28rpx;
  -webkit-line-clamp: 8;
}

.detail-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 36rpx;
}

.detail-metric {
  width: calc(50% - 9rpx);
  padding: 26rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #f5f5f1;
}

.detail-metric--wide {
  width: 100%;
}

.metric-label {
  display: block;
  color: #768079;
  font-size: 23rpx;
}

.metric-value,
.daily-cost {
  display: block;
  margin-top: 10rpx;
  font-size: 29rpx;
  font-weight: 600;
}

.daily-cost {
  color: var(--color-brand);
  font-size: 35rpx;
}

.date-section {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eceeea;
}

.date-row {
  display: block;
  margin-top: 8rpx;
  color: #68716c;
  font-size: 25rpx;
}

.detail-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 34rpx;
}

.edit-button,
.delete-button {
  flex: 1;
  margin: 0;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.edit-button {
  color: var(--color-brand);
  background: var(--color-brand-soft);
}

.delete-button {
  color: #a64138;
  background: #f8e9e7;
}
