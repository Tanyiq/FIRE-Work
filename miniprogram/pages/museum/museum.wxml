<page-meta page-style="{{themePageStyle}}"></page-meta>
<view class="page-shell">
  <view class="eyebrow">LIFE MUSEUM</view>
  <text class="page-title">人生博物馆</text>

  <view wx:if="{{isGuidedMuseumStep}}" class="guide-focus-card">
    <view class="guide-focus-card__top">
      <text class="guide-focus-card__step">STEP 4 / 4</text>
      <text class="guide-focus-card__exit" hover-class="tap-text--active" bindtap="onExitGuide">暂时退出引导</text>
    </view>
    <text class="guide-focus-card__title">收藏第一段人生经历</text>
    <text class="guide-focus-card__text">记录一件实物或一次经历。保存后，你的财富档案就建立完成了。</text>
  </view>

  <view wx:if="{{selectedCollection && !isGuidedMuseumStep}}" class="detail-section">
    <text class="back-action" hover-class="tap-text--active" bindtap="onCloseDetail">‹ 返回收藏列表</text>
    <view class="detail-card">
      <image wx:if="{{selectedCollection.photoPath}}" class="detail-photo" src="{{selectedCollection.photoPath}}" mode="aspectFill"></image>
      <view class="detail-heading">
        <view class="type-badge">{{selectedCollection.typeLabel}}</view>
        <view class="status-badge status-badge--{{selectedCollection.status}}">{{selectedCollection.statusLabel}}</view>
      </view>
      <text class="detail-title">{{selectedCollection.name}}</text>
      <text class="detail-story">
        {{selectedCollection.story || '还没有记录这件收藏背后的故事。'}}
      </text>

      <view class="detail-grid">
        <view class="detail-metric">
          <text class="metric-label">花费金额</text>
          <text class="metric-value">{{selectedCollection.amountText}}</text>
        </view>
        <view class="detail-metric">
          <text class="metric-label">记录天数</text>
          <text class="metric-value">{{selectedCollection.usageDays}} 天</text>
        </view>
        <view wx:if="{{selectedCollection.dailyCost !== null}}" class="detail-metric detail-metric--wide">
          <text class="metric-label">
            {{selectedCollection.status === 'retired' ? '最终每日成本' : '当前每日成本'}}
          </text>
          <text class="daily-cost">{{selectedCollection.dailyCostText}} / 天</text>
        </view>
      </view>

      <view class="date-section">
        <text class="date-row">开始日期：{{selectedCollection.startDate}}</text>
        <text wx:if="{{selectedCollection.retiredDate}}" class="date-row">
          结束日期：{{selectedCollection.retiredDate}}
        </text>
      </view>
      <view class="detail-actions">
        <button class="edit-button" bindtap="onEditCollection">编辑收藏</button>
        <button class="delete-button" bindtap="onDeleteCollection">删除收藏</button>
      </view>
    </view>
  </view>

  <view wx:else>
    <view wx:if="{{collections.length === 0 && !showAddForm && !isGuidedMuseumStep}}" class="empty-card">
      <text class="empty-symbol">◇</text>
      <text class="empty-title">收藏第一段值得记住的人生</text>
      <text class="empty-text">不必等待特别时刻，从一件有故事的物品或一次真实经历开始。</text>
    </view>

    <view wx:if="{{collections.length > 0 && !isGuidedMuseumStep}}" class="collection-section">
      <view class="section-heading">
        <text class="section-title">我的收藏</text>
        <text class="collection-count">{{collections.length}} 件</text>
      </view>
      <view class="museum-tabs">
        <view class="museum-tab {{selectedMuseumType === 'physical' ? 'museum-tab--selected' : ''}}" hover-class="tap-text--active" data-type="physical" bindtap="onMuseumTypeSelect">实物 {{physicalCount}}</view>
        <view class="museum-tab {{selectedMuseumType === 'experience' ? 'museum-tab--selected' : ''}}" hover-class="tap-text--active" data-type="experience" bindtap="onMuseumTypeSelect">经历 {{experienceCount}}</view>
      </view>
      <view wx:if="{{visibleCollections.length === 0}}" class="category-empty">
        {{selectedMuseumType === 'physical' ? '还没有实物收藏' : '还没有经历收藏'}}
      </view>
      <view wx:for="{{visibleCollections}}" wx:key="id" class="collection-card" hover-class="tap-card--active" data-id="{{item.id}}" bindtap="onViewCollection">
        <image wx:if="{{item.photoPath}}" class="collection-photo" src="{{item.photoPath}}" mode="aspectFill"></image>
        <text class="collection-name">{{item.name}}</text>
        <view class="collection-summary">
          <view class="collection-summary__item">
            <text class="collection-summary__label">开始时间</text>
            <text class="collection-summary__value">{{item.startDate}}</text>
          </view>
          <view class="collection-summary__item collection-summary__item--center">
            <text class="collection-summary__label">累计天数</text>
            <text class="collection-summary__value">{{item.usageDays}} 天</text>
          </view>
          <view class="collection-summary__item collection-summary__item--right">
            <text class="collection-summary__label">平均每天</text>
            <text class="collection-summary__value">{{item.dailyCostText}} / 天</text>
          </view>
        </view>
      </view>
    </view>

    <view id="collectionForm" wx:if="{{showAddForm}}" class="collection-form">
      <text class="form-title">{{editingCollectionId ? '编辑人生收藏' : '添加人生收藏'}}</text>

      <text class="field-label">收藏类型</text>
      <picker mode="selector" range="{{typeOptions}}" range-key="label" value="{{selectedTypeIndex}}" bindchange="onTypeChange">
        <view class="picker-field">
          <text>{{selectedTypeLabel}}</text>
          <text class="picker-arrow">选择 ›</text>
        </view>
      </picker>

      <text class="field-label">名称</text>
      <input class="text-field" value="{{nameInput}}" placeholder="例如：第一台相机" bindinput="onNameInput" />

      <text class="field-label">花费金额（元）</text>
      <input class="text-field" type="digit" value="{{amountInput}}" placeholder="例如 8000" bindinput="onAmountInput" />

      <text class="field-label">开始 / 发生日期</text>
      <picker mode="date" value="{{startDate}}" end="{{retiredDate}}" bindchange="onStartDateChange">
        <view class="picker-field">
          <text>{{startDate}}</text>
          <text class="picker-arrow">选择 ›</text>
        </view>
      </picker>

      <text class="field-label">{{statusFieldLabel}}</text>
      <view class="status-selector">
        <view
          wx:for="{{statusOptions}}"
          wx:key="value"
          class="status-option {{selectedStatusIndex === index ? 'status-option--selected' : ''}}"
          hover-class="tap-card--active"
          data-index="{{index}}"
          bindtap="onStatusSelect"
        >{{item.label}}</view>
      </view>

      <view wx:if="{{selectedStatusIndex === 1}}">
        <text class="field-label">{{retiredDateLabel}}</text>
        <picker mode="date" value="{{retiredDate}}" start="{{startDate}}" end="{{today}}" bindchange="onRetiredDateChange">
          <view class="picker-field">
            <text>{{retiredDate}}</text>
            <text class="picker-arrow">选择 ›</text>
          </view>
        </picker>
      </view>

      <text class="field-label">故事</text>
      <textarea class="story-field" value="{{storyInput}}" maxlength="500" placeholder="它为什么值得被记住？" bindinput="onStoryInput"></textarea>

      <text class="field-label">照片（可选）</text>
      <view wx:if="{{photoPathInput}}" class="photo-preview">
        <image class="photo-preview__image" src="{{photoPathInput}}" mode="aspectFill"></image>
        <text class="photo-remove" hover-class="tap-text--active" bindtap="onRemovePhoto">移除照片</text>
      </view>
      <button wx:else class="photo-button" loading="{{isChoosingPhoto}}" disabled="{{isChoosingPhoto}}" bindtap="onChoosePhoto">从相册或相机添加照片</button>

      <text wx:if="{{validationMessage}}" class="validation-message">{{validationMessage}}</text>
      <button class="save-button" bindtap="onSaveCollection">{{editingCollectionId ? '保存修改' : (isGuidedMuseumStep ? '保存并完成档案' : '保存收藏')}}</button>
    </view>

    <button wx:if="{{!isGuidedMuseumStep}}" class="add-button page-bottom-action" bindtap="onToggleAddForm">
      {{showAddForm ? (editingCollectionId ? '取消编辑' : '收起录入') : '+ 添加人生收藏'}}
    </button>

  </view>
</view>
