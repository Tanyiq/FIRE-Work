@import "./styles/design-tokens.wxss";

page {
  min-height: 100%;
  background: #f7f5ef;
  background: var(--color-background);
  color: #243029;
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page-shell {
  padding: 48rpx 36rpx 64rpx;
  padding: var(--space-xl) 36rpx 64rpx;
  box-sizing: border-box;
}

.eyebrow {
  margin-bottom: 16rpx;
  margin-bottom: var(--space-sm);
  color: #536a8a;
  color: var(--color-brand);
  font-size: 24rpx;
  font-size: var(--font-body);
  font-weight: 600;
  letter-spacing: 4rpx;
}

.page-title {
  display: block;
  color: #1f2a24;
  color: var(--color-text-strong);
  font-size: 52rpx;
  font-size: var(--font-display);
  font-weight: 700;
  line-height: 1.25;
}

.page-description {
  display: block;
  margin-top: 20rpx;
  color: #727c76;
  color: var(--color-text-muted);
  font-size: 30rpx;
  line-height: 1.7;
}

.placeholder-card {
  margin-top: 56rpx;
  padding: 36rpx;
  border: 1rpx solid #e4e1d8;
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
  border-radius: var(--radius-md);
  background: #ffffff;
  background: var(--color-surface);
  box-shadow: 0 12rpx 36rpx rgba(42, 57, 48, 0.06);
  box-shadow: var(--shadow-card);
}

button {
  transition: opacity 180ms ease, transform 180ms ease;
  transition: opacity var(--motion-fast) ease, transform var(--motion-fast) ease;
}

button:active {
  opacity: 0.86;
  transform: scale(0.985);
}

button::after {
  border: 0;
}

.placeholder-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}

.placeholder-text {
  display: block;
  margin-top: 14rpx;
  color: #7a817d;
  font-size: 27rpx;
  line-height: 1.65;
}

.guide-focus-card {
  margin-top: var(--space-lg);
  padding: 30rpx;
  border: 2rpx solid var(--color-brand);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.guide-focus-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.guide-focus-card__step {
  color: var(--color-brand);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.guide-focus-card__exit {
  color: var(--color-text-muted);
  font-size: 23rpx;
}

.guide-focus-card__title,
.guide-focus-card__text {
  display: block;
}

.guide-focus-card__title {
  margin-top: 22rpx;
  color: var(--color-text-strong);
  font-size: 34rpx;
  font-weight: 700;
}

.guide-focus-card__text {
  margin-top: 12rpx;
  color: var(--color-text-muted);
  font-size: 25rpx;
  line-height: 1.65;
}

.guide-focus-card__button {
  margin-top: 24rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: var(--color-brand);
  font-size: 28rpx;
  font-weight: 600;
}
